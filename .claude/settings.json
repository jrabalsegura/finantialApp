{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:integration)",
      "Bash(node --import tsx --test:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma format)",
      "Bash(make check)",
      "Bash(make container-build)",
      "Bash(make container-up)",
      "Bash(make container-status)",
      "Bash(make container-check)",
      "Bash(make container-down)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "ask": [
      "Bash(make deploy:*)",
      "Bash(ssh:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
