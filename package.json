{
  "name": "financial-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:unit": "node --import tsx --test src/domain/*.test.ts",
    "test:integration": "node --import tsx --test tests/*.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "next": "^15.5.25",
    "prisma": "^6.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
